<view class="container">
  <!-- 顶部公告 -->
  <view wx:if="{{announcement}}" class="notice-banner">
    <text class="notice-icon">📣</text>
    <text class="notice-text">{{announcement}}</text>
  </view>

  <!-- 轻盈欢迎 Hero 卡 -->
  <view class="hero-card">
    <view class="hero-top-row">
      <view class="hero-brand-pill">AILOVE · 恋爱军师</view>
      <view wx:if="{{quotaText}}" class="hero-quota-pill">{{quotaText}}</view>
    </view>

    <view class="hero-title">
      {{userInfo && userInfo.nickname ? ('你好，' + userInfo.nickname) : '懂你心事的恋爱军师'}}
    </view>
    <view class="hero-desc">
      聊不下去、猜不透潜台词？随时告诉我，帮你体面回应。
    </view>

    <view class="hero-actions">
      <button class="hero-btn-solid" bindtap="goFreeChat">✨ 自由倾诉</button>
      <button class="hero-btn-outline" bindtap="goLoveProfile">
        💞 {{loveProfile && loveProfile.is_configured ? (loveProfile.relationship_stage_label || '档案已开') : '情感档案'}}
      </button>
    </view>
  </view>

  <!-- 离线异常提示 -->
  <view wx:if="{{errorMsg}}" class="error-card">
    <text class="error-text">⚠️ {{errorMsg}}</text>
    <text class="error-retry" bindtap="bootstrapHome">重试</text>
  </view>

  <!-- 小圈子邀请码未激活提示卡 -->
  <view wx:if="{{inviteLocked}}" class="card invite-lock-card">
    <view class="invite-lock-title">🔐 内测邀请码激活</view>
    <view class="invite-lock-desc">
      请输入内测邀请码（如 LOVE-XXXXXX）解锁全部情感导师与工具。
    </view>
    <view class="invite-input-row">
      <input
        class="invite-input"
        placeholder="输入内测邀请码"
        value="{{inviteInput}}"
        maxlength="32"
        bindinput="onInviteInput"
      />
      <button
        class="primary-btn invite-btn"
        loading="{{verifyingInvite}}"
        bindtap="handleVerifyInvite"
      >
        解锁
      </button>
    </view>
  </view>

  <!-- 两大核心高频工具（去重后仅保留最高频两项） -->
  <view class="tool-grid">
    <view class="tool-card tool-rose" bindtap="goReplyHelper">
      <view class="tool-head">
        <text class="tool-emoji">💬</text>
        <text class="tool-badge">支持识图</text>
      </view>
      <view class="tool-title">帮我回消息</view>
      <view class="tool-desc">贴原话或微信截图，3 条高情商回复</view>
    </view>
    <view class="tool-card tool-ice" bindtap="goSoftenDraft">
      <view class="tool-head">
        <text class="tool-emoji">🧊</text>
        <text class="tool-badge tool-badge-ice">先降温</text>
      </view>
      <view class="tool-title">先别发 · 柔化器</view>
      <view class="tool-desc">气头上别硬刚，狠话改写体面表达</view>
    </view>
  </view>

  <!-- 5 位专属恋爱导师（清爽单行列表） -->
  <view class="section-head">
    <text class="section-title">找一位导师聊聊</text>
    <text wx:if="{{allPersonas.length > 0}}" class="section-more">{{allPersonas.length}} 位在线</text>
  </view>

  <view wx:if="{{loading && allPersonas.length === 0}}" class="empty-box">
    正在唤醒恋爱导师...
  </view>

  <view wx:else class="card persona-card-group">
    <view
      wx:for="{{allPersonas}}"
      wx:key="id"
      class="persona-row"
      data-id="{{item.id}}"
      bindtap="onTapPersona"
    >
      <view class="persona-avatar">{{item.avatar_emoji || '💘'}}</view>
      <view class="persona-info">
        <view class="persona-name">{{item.name}}</view>
        <view class="persona-desc">{{item.description}}</view>
      </view>
      <text class="persona-go">聊聊 ›</text>
    </view>
  </view>

  <!-- 最近续聊（最多 2 条，无记录时隐藏） -->
  <view wx:if="{{recentConversations.length > 0}}" class="recent-wrap">
    <view class="section-head">
      <text class="section-title">最近继续聊</text>
      <text class="section-more" bindtap="onOpenHistoryTab">全部 ›</text>
    </view>
    <view class="card recent-card">
      <view
        wx:for="{{recentConversations}}"
        wx:key="session_id"
        class="recent-item"
        data-sid="{{item.session_id}}"
        bindtap="onTapConversation"
      >
        <view class="recent-left">
          <view class="recent-title-row">
            <text wx:if="{{item.is_pinned}}" class="recent-pin">📌</text>
            <text class="recent-title">{{item.title}}</text>
          </view>
          <view wx:if="{{item.persona_name}}" class="recent-meta">
            <text class="recent-persona">{{item.persona_name}}</text>
          </view>
        </view>
        <text class="recent-arrow">续聊 ›</text>
      </view>
    </view>
  </view>

  <mascot-lian bottomOffset="{{130}}" pageHint="有心事或功能疑问点我呀~" />
</view>

<view class="container">
  <!-- 顶部公告 -->
  <view wx:if="{{announcement}}" class="notice-banner">
    <text class="notice-icon">📣</text>
    <text class="notice-text">{{announcement}}</text>
  </view>

  <!-- 品牌 Hero 卡片 -->
  <view class="hero-card">
    <view class="hero-top-row">
      <view class="hero-brand-pill">AILOVE · 恋爱情感 AI</view>
      <view wx:if="{{quotaText}}" class="hero-quota-pill">{{quotaText}}</view>
    </view>

    <view class="hero-title">
      {{userInfo && userInfo.nickname ? ('你好，' + userInfo.nickname) : '懂你心事的恋爱军师'}}
    </view>
    <view class="hero-desc">
      聊不下去、捉摸不透潜台词、异地或冷战卡壳？把心事交给更懂中文情感的专属 AI 导师。
    </view>

    <!-- 情感档案状态捷径 -->
    <view class="profile-strip" bindtap="goLoveProfile">
      <view class="profile-strip-left">
        <text class="profile-strip-emoji">💞</text>
        <text class="profile-strip-text" wx:if="{{loveProfile && loveProfile.is_configured}}">
          {{loveProfile.relationship_stage_label || '情感档案已填写'}} · {{loveProfile.auto_inject ? '记忆已自动生效' : '记忆已暂停'}}
        </text>
        <text class="profile-strip-text" wx:else>
          建立我的「情感背景记忆卡」，聊天不用重复交代
        </text>
      </view>
      <text class="profile-strip-arrow">去设置 ›</text>
    </view>

    <view class="hero-actions">
      <button class="hero-btn-solid" bindtap="goReplyHelper">💬 帮我回消息</button>
      <button class="hero-btn-outline" bindtap="goFreeChat">✨ 自由倾诉</button>
    </view>
  </view>

  <!-- 离线异常提示 -->
  <view wx:if="{{errorMsg}}" class="error-card">
    <text class="error-text">⚠️ {{errorMsg}}</text>
    <text class="error-retry" bindtap="bootstrapHome">重试</text>
  </view>

  <!-- 两大核心高频工具卡片 -->
  <view class="tool-grid">
    <view class="tool-card tool-rose" bindtap="goReplyHelper">
      <view class="tool-emoji">💬</view>
      <view class="tool-title">帮我回消息</view>
      <view class="tool-desc">粘贴 TA 的原话，秒拆潜台词 + 3 条可复制高情商回复</view>
    </view>
    <view class="tool-card tool-blush" bindtap="goLoveProfile">
      <view class="tool-emoji">💞</view>
      <view class="tool-title">我的情感档案</view>
      <view class="tool-desc">记录恋爱阶段、对方性格与雷区，每次咨询都贴合处境</view>
    </view>
  </view>

  <!-- 5 大恋爱情感智能体导师 -->
  <view class="section-head">
    <text class="section-title">专属恋爱情感导师</text>
    <text class="section-more">{{allPersonas.length}} 位在线</text>
  </view>

  <scroll-view class="cat-scroll" scroll-x="true" enable-flex="true">
    <view class="cat-row">
      <view
        wx:for="{{categories}}"
        wx:key="key"
        class="cat-pill {{activeCategory === item.key ? 'cat-pill-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSelectCategory"
      >
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{loading && filteredPersonas.length === 0}}" class="empty-box">
    正在唤醒专属恋爱导师...
  </view>

  <view wx:else class="persona-list">
    <view
      wx:for="{{filteredPersonas}}"
      wx:key="id"
      class="persona-card"
      data-id="{{item.id}}"
      bindtap="onTapPersona"
    >
      <view class="persona-main">
        <view class="persona-avatar">{{item.avatar_emoji || '💘'}}</view>
        <view class="persona-info">
          <view class="persona-title-row">
            <text class="persona-name">{{item.name}}</text>
            <text class="persona-usage">{{item.usage_count || 0}} 次咨询</text>
          </view>
          <view class="persona-desc">{{item.description}}</view>
        </view>
      </view>
      <view
        wx:if="{{item.starter_prompts && item.starter_prompts.length > 0}}"
        class="persona-starter"
        catchtap="onTapStarter"
        data-id="{{item.id}}"
        data-prompt="{{item.starter_prompts[0]}}"
      >
        <text class="starter-tag">试试问</text>
        <text class="starter-txt">{{item.starter_prompts[0]}}</text>
        <text class="starter-go">›</text>
      </view>
    </view>
  </view>

  <!-- 最近历史会话快捷续聊 -->
  <view wx:if="{{recentConversations.length > 0}}" class="recent-wrap">
    <view class="section-head">
      <text class="section-title">最近咨询续聊</text>
      <text class="section-more" bindtap="onOpenHistoryTab">全部历史 ›</text>
    </view>
    <view class="card recent-card">
      <view
        wx:for="{{recentConversations}}"
        wx:key="session_id"
        class="recent-item"
        data-sid="{{item.session_id}}"
        bindtap="onTapConversation"
      >
        <view class="recent-left">
          <view class="recent-title-row">
            <text wx:if="{{item.is_pinned}}" class="recent-pin">📌</text>
            <text class="recent-title">{{item.title}}</text>
          </view>
          <view class="recent-meta">
            <text wx:if="{{item.persona_name}}" class="recent-persona">{{item.persona_name}}</text>
            <text class="recent-model">{{item.model_name || 'AI'}}</text>
          </view>
        </view>
        <text class="recent-arrow">续聊 ›</text>
      </view>
    </view>
  </view>
</view>

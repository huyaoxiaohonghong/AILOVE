.notice-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 22rpx;
  border-radius: 18rpx;
  background: #fff5f6;
  border: 1rpx solid #f6ccd5;
  margin-bottom: 22rpx;
}

.notice-icon {
  font-size: 26rpx;
}

.notice-text {
  font-size: 24rpx;
  color: #9e2440;
  line-height: 1.45;
}

.hero-card {
  background: linear-gradient(135deg, #d84361 0%, #c83553 60%, #a82745 100%);
  color: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 14rpx 34rpx rgba(200, 53, 83, 0.28);
}

.hero-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.hero-brand-pill {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}

.hero-quota-pill {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(29, 23, 32, 0.2);
  color: #ffe8ee;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
  letter-spacing: 0.5rpx;
}

.hero-desc {
  font-size: 25rpx;
  line-height: 1.6;
  color: rgba(255, 245, 247, 0.9);
  margin-bottom: 22rpx;
}

.profile-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  margin-bottom: 24rpx;
}

.profile-strip-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}

.profile-strip-emoji {
  font-size: 28rpx;
  flex-shrink: 0;
}

.profile-strip-text {
  font-size: 24rpx;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-strip-arrow {
  font-size: 23rpx;
  color: #ffe5ec;
  flex-shrink: 0;
  font-weight: 600;
}

.hero-actions {
  display: flex;
  gap: 18rpx;
}

.hero-btn-solid,
.hero-btn-outline {
  flex: 1;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 600;
  margin: 0;
  padding: 0;
}

.hero-btn-solid {
  background: #ffffff;
  color: #c83553;
}

.hero-btn-outline {
  background: rgba(255, 255, 255, 0.15);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
}

.hero-btn-solid::after,
.hero-btn-outline::after {
  border: none;
}

.error-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #fff1f2;
  border: 1rpx solid #fecdd3;
  margin-bottom: 24rpx;
}

.error-text {
  font-size: 24rpx;
  color: #be123c;
  flex: 1;
}

.error-retry {
  font-size: 24rpx;
  font-weight: 600;
  color: #c83553;
  margin-left: 16rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-bottom: 30rpx;
}

.tool-card {
  border-radius: 22rpx;
  padding: 24rpx;
  border: 1rpx solid #f1e3e8;
}

.tool-rose {
  background: linear-gradient(180deg, #fff5f7 0%, #ffffff 100%);
}

.tool-ice {
  background: linear-gradient(180deg, #f0f9ff 0%, #ffffff 100%);
}

.tool-blush {
  background: linear-gradient(180deg, #fff8f2 0%, #ffffff 100%);
}

.tool-gold {
  background: linear-gradient(180deg, #fefce8 0%, #ffffff 100%);
}

.invite-lock-card {
  margin-bottom: 24rpx;
  border: 1rpx solid #f5c2cd;
  background: linear-gradient(135deg, #fff7f9 0%, #ffffff 100%);
}

.invite-lock-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #a92442;
  margin-bottom: 8rpx;
}

.invite-lock-desc {
  font-size: 23rpx;
  color: #6b5f70;
  line-height: 1.55;
  margin-bottom: 18rpx;
}

.invite-input-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.invite-input {
  flex: 1;
  height: 76rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #efd9e0;
  font-size: 27rpx;
}

.invite-btn {
  width: 148rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 27rpx;
  margin: 0;
  padding: 0;
}

.tool-emoji {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.tool-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1d1720;
  margin-bottom: 6rpx;
}

.tool-desc {
  font-size: 22rpx;
  color: #7c7080;
  line-height: 1.5;
}

.cat-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.cat-row {
  display: inline-flex;
  gap: 14rpx;
  padding-bottom: 4rpx;
}

.cat-pill {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #66596a;
  font-size: 24rpx;
  border: 1rpx solid #eee2e7;
}

.cat-pill-active {
  background: #c83553;
  color: #ffffff;
  border-color: #c83553;
  font-weight: 600;
}

.empty-box {
  text-align: center;
  padding: 48rpx 20rpx;
  font-size: 26rpx;
  color: #8c8091;
}

.persona-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 30rpx;
}

.persona-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #f1e6ea;
  box-shadow: 0 6rpx 20rpx rgba(200, 53, 83, 0.04);
}

.persona-main {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.persona-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: #fff2f5;
  border: 1rpx solid #f7d6df;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  flex-shrink: 0;
}

.persona-info {
  flex: 1;
  min-width: 0;
}

.persona-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.persona-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1d1720;
}

.persona-usage {
  font-size: 21rpx;
  color: #9b8e9f;
}

.persona-desc {
  font-size: 24rpx;
  color: #6b5f70;
  line-height: 1.55;
}

.persona-starter {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: #faf5f7;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.starter-tag {
  font-size: 20rpx;
  font-weight: 600;
  color: #c83553;
  background: #ffe8ee;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.starter-txt {
  flex: 1;
  font-size: 23rpx;
  color: #4b4050;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.starter-go {
  color: #c83553;
  font-size: 28rpx;
  font-weight: 600;
}

.recent-wrap {
  margin-top: 10rpx;
}

.recent-card {
  padding: 8rpx 24rpx;
}

.recent-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3eaee;
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-left {
  flex: 1;
  min-width: 0;
}

.recent-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.recent-pin {
  font-size: 22rpx;
}

.recent-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #1d1720;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-meta {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.recent-persona {
  font-size: 21rpx;
  color: #c83553;
  background: #fff2f5;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.recent-model {
  font-size: 21rpx;
  color: #9b8e9f;
}

.recent-arrow {
  font-size: 24rpx;
  color: #c83553;
  font-weight: 600;
  flex-shrink: 0;
}

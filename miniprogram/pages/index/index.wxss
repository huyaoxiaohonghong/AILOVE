.notice-banner {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  background: #fff5f6;
  border: 1rpx solid #f6ccd5;
  margin-bottom: 20rpx;
}

.notice-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.notice-text {
  font-size: 23rpx;
  color: #9e2440;
  line-height: 1.45;
}

.hero-card {
  background: linear-gradient(135deg, #d84361 0%, #c83553 60%, #a82745 100%);
  color: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 28rpx 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 12rpx 30rpx rgba(200, 53, 83, 0.24);
}

.hero-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.hero-brand-pill {
  font-size: 21rpx;
  font-weight: 600;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}

.hero-quota-pill {
  font-size: 21rpx;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(29, 23, 32, 0.18);
  color: #ffe8ee;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  letter-spacing: 0.4rpx;
}

.hero-desc {
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(255, 245, 247, 0.9);
  margin-bottom: 22rpx;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-btn-solid,
.hero-btn-outline {
  flex: 1;
  width: 0;
  height: 76rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  padding: 0 16rpx;
}

.hero-btn-solid {
  background: #ffffff;
  color: #c83553;
}

.hero-btn-outline {
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.42);
}

.error-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #fff1f2;
  border: 1rpx solid #fecdd3;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 23rpx;
  color: #be123c;
  flex: 1;
}

.error-retry {
  font-size: 24rpx;
  font-weight: 600;
  color: #c83553;
  margin-left: 16rpx;
}

.invite-lock-card {
  margin-bottom: 20rpx;
  border: 1rpx solid #f5c2cd;
  background: linear-gradient(135deg, #fff7f9 0%, #ffffff 100%);
}

.invite-lock-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #a92442;
  margin-bottom: 6rpx;
}

.invite-lock-desc {
  font-size: 23rpx;
  color: #6b5f70;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.invite-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.invite-input {
  flex: 1;
  min-width: 0;
  height: 74rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #efd9e0;
  font-size: 26rpx;
}

.invite-btn {
  width: 136rpx !important;
  flex-shrink: 0;
  height: 74rpx;
  font-size: 26rpx;
  padding: 0;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 26rpx;
}

.tool-card {
  border-radius: 22rpx;
  padding: 22rpx 22rpx 20rpx;
  border: 1rpx solid #f1e3e8;
  box-shadow: 0 4rpx 16rpx rgba(200, 53, 83, 0.04);
}

.tool-rose {
  background: linear-gradient(180deg, #fff5f7 0%, #ffffff 100%);
}

.tool-ice {
  background: linear-gradient(180deg, #f0f9ff 0%, #ffffff 100%);
}

.tool-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.tool-emoji {
  font-size: 38rpx;
}

.tool-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  background: #ffe6ed;
  color: #c83553;
}

.tool-badge-ice {
  background: #e0f2fe;
  color: #0369a1;
}

.tool-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #1d1720;
  margin-bottom: 6rpx;
}

.tool-desc {
  font-size: 22rpx;
  color: #7c7080;
  line-height: 1.45;
}

.empty-box {
  text-align: center;
  padding: 40rpx 20rpx;
  font-size: 25rpx;
  color: #8c8091;
}

.persona-card-group {
  padding: 6rpx 24rpx;
  margin-bottom: 24rpx;
}

.persona-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3eaee;
}

.persona-row:last-child {
  border-bottom: none;
}

.persona-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: #fff2f5;
  border: 1rpx solid #f7d6df;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
}

.persona-info {
  flex: 1;
  min-width: 0;
}

.persona-name {
  font-size: 29rpx;
  font-weight: 700;
  color: #1d1720;
  margin-bottom: 4rpx;
}

.persona-desc {
  font-size: 23rpx;
  color: #76697a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.persona-go {
  font-size: 23rpx;
  color: #c83553;
  font-weight: 600;
  flex-shrink: 0;
}

.recent-wrap {
  margin-top: 4rpx;
}

.recent-card {
  padding: 6rpx 24rpx;
  margin-bottom: 0;
}

.recent-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f3eaee;
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-left {
  flex: 1;
  min-width: 0;
}

.recent-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.recent-pin {
  font-size: 21rpx;
}

.recent-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #1d1720;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-meta {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
}

.recent-persona {
  font-size: 20rpx;
  color: #c83553;
  background: #fff2f5;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.recent-arrow {
  font-size: 23rpx;
  color: #c83553;
  font-weight: 600;
  flex-shrink: 0;
}

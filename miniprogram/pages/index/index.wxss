.hero-card {
  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
}

.hero-tag {
  display: inline-block;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-desc {
  font-size: 26rpx;
  line-height: 1.6;
  opacity: 0.9;
  margin-bottom: 28rpx;
}

.hero-actions {
  display: flex;
  gap: 16rpx;
}

.hero-btn,
.hero-btn-outline {
  flex: 1;
  font-size: 26rpx;
  border-radius: 14rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
}

.hero-btn {
  background: #ffffff;
  color: #4f46e5;
  font-weight: 600;
}

.hero-btn-outline {
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
}

.hero-btn::after,
.hero-btn-outline::after {
  border: none;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.meta-list {
  border-top: 2rpx solid #f3f4f6;
  padding-top: 12rpx;
}

.meta-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #f9fafb;
}

.meta-label {
  color: #6b7280;
  font-size: 26rpx;
}

.meta-value {
  color: #111827;
  font-size: 26rpx;
  font-weight: 500;
  max-width: 64%;
  text-align: right;
  word-break: break-all;
}

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.quick-item {
  background: #f9fafb;
  border: 2rpx solid #eef0f4;
  border-radius: 16rpx;
  padding: 24rpx;
}

.quick-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 8rpx;
}

.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f7fb;
}

.chat-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 28rpx;
  background: #ffffff;
  border-bottom: 2rpx solid #eef0f4;
}

.toolbar-info {
  font-size: 24rpx;
  color: #6b7280;
}

.toolbar-clear {
  font-size: 24rpx;
  color: #4f46e5;
}

.chat-scroll {
  flex: 1;
  overflow: hidden;
}

.msg-list {
  padding: 24rpx 28rpx 40rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-user {
  justify-content: flex-end;
}

.msg-ai {
  justify-content: flex-start;
}

.msg-bubble {
  max-width: 78%;
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
  white-space: pre-wrap;
}

.msg-ai .msg-bubble {
  background: #ffffff;
  color: #1f2937;
  border: 2rpx solid #e5e7eb;
}

.msg-user .msg-bubble {
  background: #4f46e5;
  color: #ffffff;
}

.loading-bubble {
  color: #6b7280 !important;
}

.chat-composer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 2rpx solid #e5e7eb;
}

.composer-input {
  flex: 1;
  height: 76rpx;
  background: #f3f4f6;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.composer-send {
  width: 140rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  border-radius: 16rpx;
  background: #4f46e5;
  color: #ffffff;
  font-size: 28rpx;
}

.composer-send[disabled] {
  background: #c7d2fe;
  color: #ffffff;
}

.composer-send::after {
  border: none;
}

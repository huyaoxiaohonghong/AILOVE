.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #faf7f8;
}

.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 14rpx 22rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f1e6ea;
  flex-shrink: 0;
}

.mode-trigger {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  max-width: 60%;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #fff3f6;
  border: 1rpx solid #f5cbd5;
  min-width: 0;
}

.mode-name {
  font-size: 25rpx;
  font-weight: 700;
  color: #a92442;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mode-dot {
  font-size: 19rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: #ffe3eb;
  color: #c83553;
  font-weight: 600;
  flex-shrink: 0;
}

.mode-dot-warn {
  background: #fef3c7;
  color: #92400e;
}

.mode-dot-skill {
  background: #dcfce7;
  color: #166534;
}

.mode-caret {
  font-size: 22rpx;
  color: #c83553;
  flex-shrink: 0;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.header-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f8f2f4;
  color: #4f4354;
  font-size: 23rpx;
  font-weight: 500;
}

.header-pill-new {
  color: #c83553;
  background: #fff3f6;
  font-weight: 600;
}

.pill-count {
  font-size: 20rpx;
  padding: 0 9rpx;
  border-radius: 999rpx;
  background: #ffe5ec;
  color: #c83553;
  font-weight: 600;
}

.incognito-strip {
  padding: 10rpx 24rpx;
  background: #fffbeb;
  border-bottom: 1rpx solid #fde68a;
  color: #92400e;
  font-size: 22rpx;
  text-align: center;
  flex-shrink: 0;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
}

.history-loading {
  text-align: center;
  padding: 16rpx;
  font-size: 23rpx;
  color: #8c8091;
}

.msg-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 16rpx;
}

.msg-row {
  display: flex;
}

.msg-user {
  justify-content: flex-end;
}

.msg-ai {
  justify-content: flex-start;
}

.msg-bubble {
  max-width: 85%;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  line-height: 1.65;
  word-break: break-word;
}

.msg-user .msg-bubble {
  background: linear-gradient(135deg, #d84361 0%, #c83553 100%);
  color: #ffffff;
  border-bottom-right-radius: 8rpx;
  box-shadow: 0 8rpx 20rpx rgba(200, 53, 83, 0.2);
}

.msg-ai .msg-bubble {
  background: #ffffff;
  color: #1d1720;
  border: 1rpx solid #f0e4e9;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(29, 23, 32, 0.04);
}

.msg-error {
  border-color: #fecdd3 !important;
  color: #be123c !important;
}

.bubble-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.bubble-role {
  font-size: 21rpx;
  font-weight: 600;
  color: #8e8093;
}

.profile-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #fff2f5;
  color: #c83553;
}

.reasoning-box {
  margin-bottom: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: #faf5f7;
  border-left: 6rpx solid #e7b5c1;
}

.reasoning-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: #7c6f82;
  font-weight: 600;
}

.reasoning-content {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #6b5f70;
  line-height: 1.55;
  white-space: pre-wrap;
}

.bubble-text {
  white-space: pre-wrap;
}

.skill-cites-box {
  margin-top: 14rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  background: #f0fdf4;
  border: 1rpx solid #bbf7d0;
}

.skill-cite-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.skill-cite-head {
  font-size: 22rpx;
  font-weight: 600;
  color: #166534;
}

.skill-cite-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.skill-cite-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #86efac;
  color: #15803d;
}

.care-card {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid #f3c4cf;
  background: linear-gradient(135deg, #fff6f8 0%, #fffaf3 100%);
}

.care-crisis {
  border-color: #d84361;
  background: linear-gradient(135deg, #fff0f3 0%, #fff6ec 100%);
}

.care-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #9f1f3a;
  margin-bottom: 6rpx;
}

.care-msg {
  font-size: 23rpx;
  color: #5b4d5d;
  line-height: 1.55;
  margin-bottom: 12rpx;
}

.care-hotlines {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hotline-chip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid #f2c8d2;
  font-size: 22rpx;
  color: #8f1d37;
}

.hotline-num {
  font-weight: 700;
}

.bubble-foot {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed #efe4e8;
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
}

.fav-btn {
  font-size: 22rpx;
  color: #7c6f82;
  font-weight: 500;
}

.copy-btn {
  font-size: 22rpx;
  color: #c83553;
  font-weight: 500;
}

/* 开场空态快捷区 */
.welcome-dock {
  margin-top: 6rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dock-tools {
  display: flex;
  gap: 14rpx;
}

.dock-tool-pill {
  flex: 1;
  text-align: center;
  padding: 16rpx 14rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.dock-rose {
  background: #fff1f4;
  color: #c83553;
  border: 1rpx solid #f4c7d2;
}

.dock-ice {
  background: #f0f9ff;
  color: #0369a1;
  border: 1rpx solid #bae6fd;
}

.dock-starters {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #f0e4e9;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.dock-label {
  font-size: 22rpx;
  color: #8c8091;
  font-weight: 600;
}

.dock-starter-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #faf5f7;
  font-size: 24rpx;
  color: #4b4050;
}

.dock-starter-txt {
  flex: 1;
  line-height: 1.45;
}

.dock-starter-go {
  color: #c83553;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* 底部输入栏 */
.chat-composer {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 22rpx 16rpx;
  background: #ffffff;
  border-top: 1rpx solid #f1e6ea;
  flex-shrink: 0;
}

.composer-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 26rpx;
  background: #f8f2f4;
  border-radius: 999rpx;
  font-size: 27rpx;
  color: #1d1720;
}

.composer-send,
.composer-stop {
  width: 120rpx !important;
  flex-shrink: 0;
  height: 76rpx;
  padding: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.composer-send {
  background: linear-gradient(135deg, #d84361 0%, #c83553 100%);
  color: #ffffff;
}

.composer-send[disabled] {
  opacity: 0.45;
  background: #d84361;
  color: #ffffff;
}

.composer-stop {
  background: #fff1f2;
  color: #be123c;
  border: 1rpx solid #fda4af;
}

/* 底部抽屉通用 */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(29, 23, 32, 0.45);
  z-index: 99;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet-panel {
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 76vh;
  display: flex;
  flex-direction: column;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx 18rpx;
  border-bottom: 1rpx solid #f1e6ea;
}

.sheet-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #1d1720;
}

.sheet-close {
  font-size: 26rpx;
  color: #c83553;
  font-weight: 600;
}

.sheet-scroll {
  max-height: 62vh;
  padding: 20rpx 26rpx 30rpx;
  box-sizing: border-box;
}

.sheet-empty {
  text-align: center;
  padding: 60rpx 20rpx;
  font-size: 26rpx;
  color: #8c8091;
}

/* 导师与模式抽屉内容 */
.mode-section-block {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #f3eaee;
}

.mode-section-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #6b5f70;
  margin-bottom: 14rpx;
}

.mode-chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.p-chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #faf5f7;
  color: #5b4f60;
  font-size: 24rpx;
  border: 1rpx solid #efe4e8;
}

.p-chip-active {
  background: #fff1f4;
  color: #c83553;
  border-color: #d84361;
  font-weight: 600;
}

.mode-persona-hint {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #faf5f7;
  font-size: 23rpx;
  color: #6b5f70;
  line-height: 1.5;
}

.sk-chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f0fdf4;
  border: 1rpx solid #bbf7d0;
  color: #166534;
  font-size: 23rpx;
}

.sk-chip-active {
  background: #16a34a;
  border-color: #16a34a;
  color: #ffffff;
  font-weight: 600;
}

.mode-setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f5eef1;
}

.mode-setting-row:last-child {
  border-bottom: none;
}

.mode-setting-text {
  flex: 1;
  min-width: 0;
}

.mode-setting-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #1d1720;
  margin-bottom: 4rpx;
}

.mode-setting-sub {
  font-size: 22rpx;
  color: #8c8091;
}

.mode-setting-arrow {
  font-size: 24rpx;
  color: #c83553;
  font-weight: 600;
  flex-shrink: 0;
}

/* 历史列表项 */
.hist-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 14rpx;
  border-radius: 18rpx;
  background: #faf6f7;
  border: 1rpx solid transparent;
}

.hist-pinned {
  border-left: 6rpx solid #c83553;
}

.hist-active {
  background: #fff1f4;
  border-color: #f3bcc9;
}

.hist-main {
  flex: 1;
  min-width: 0;
}

.hist-title-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.hist-pin {
  font-size: 22rpx;
}

.hist-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #1d1720;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hist-meta {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
}

.hist-persona {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #ffe8ee;
  color: #c83553;
}

.hist-ops {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.hist-op-btn {
  font-size: 22rpx;
  color: #6b5f70;
}

.hist-op-del {
  font-size: 22rpx;
  color: #dc2626;
}

<view class="chat-page">
  <!-- 单行极简顶栏：左侧导师与模式切换，右侧历史与新对话 -->
  <view class="chat-header">
    <view class="mode-trigger" bindtap="onOpenModeSheet">
      <text class="mode-name">
        {{activePersona ? ((activePersona.avatar_emoji || '💘') + ' ' + activePersona.name) : '✨ 默认助手'}}
      </text>
      <text wx:if="{{incognitoMode}}" class="mode-dot mode-dot-warn">无痕</text>
      <text wx:elif="{{selectedSkillIds.length > 0}}" class="mode-dot mode-dot-skill">知识库</text>
      <text wx:elif="{{loveProfileActive}}" class="mode-dot">档案</text>
      <text class="mode-caret">▾</text>
    </view>

    <view class="header-right">
      <view class="header-pill" bindtap="onOpenHistory">
        <text>历史</text>
        <text wx:if="{{conversations.length > 0}}" class="pill-count">{{conversations.length}}</text>
      </view>
      <view class="header-pill header-pill-new" bindtap="onNewChatTap">＋ 新对话</view>
    </view>
  </view>

  <!-- 仅在主动开启无痕时显示轻提示 -->
  <view wx:if="{{incognitoMode}}" class="incognito-strip">
    🕵️ 无痕倾诉中：本轮内容不存入云端历史，退出即销毁
  </view>

  <!-- 对话消息滚动区 -->
  <scroll-view
    class="chat-scroll"
    scroll-y="true"
    scroll-top="{{scrollTop}}"
    scroll-into-view="{{scrollToId}}"
    scroll-with-animation="true"
  >
    <view wx:if="{{loadingHistory}}" class="history-loading">正在还原历史会话...</view>

    <view class="msg-list">
      <view
        wx:for="{{messages}}"
        wx:key="id"
        id="msg-{{item.id}}"
        class="msg-row {{item.role === 'user' ? 'msg-user' : 'msg-ai'}}"
      >
        <view class="msg-bubble {{item.isError ? 'msg-error' : ''}}">
          <!-- 导师身份与情感档案标记 -->
          <view wx:if="{{item.role === 'assistant'}}" class="bubble-head">
            <text class="bubble-role">{{item.modelLabel || 'AILOVE 恋爱助手'}}</text>
            <text wx:if="{{item.loveProfileInjected}}" class="profile-tag">💞 已结合档案</text>
          </view>

          <!-- 可折叠深度思考过程 -->
          <view wx:if="{{item.reasoning}}" class="reasoning-box">
            <view class="reasoning-toggle" data-idx="{{index}}" bindtap="onToggleReasoning">
              <text>🧠 思考过程</text>
              <text>{{item.reasoningOpen ? '收起 ▲' : '展开 ▼'}}</text>
            </view>
            <view wx:if="{{item.reasoningOpen}}" class="reasoning-content">
              <text user-select="true">{{item.reasoning}}</text>
            </view>
          </view>

          <!-- 主回复正文 -->
          <view class="bubble-text">
            <text user-select="true">{{item.content || (item.reasoning ? '正在整理回复...' : '正在倾听与思考中...')}}</text>
          </view>

          <!-- 知识库 Skill 引用溯源 -->
          <view
            wx:if="{{item.role === 'assistant' && item.invokedSkills && item.invokedSkills.length > 0}}"
            class="skill-cites-box"
          >
            <view wx:for="{{item.invokedSkills}}" wx:for-item="sk" wx:key="id" class="skill-cite-item">
              <text class="skill-cite-head">🧩 参考知识库 · {{sk.name}}</text>
              <view wx:if="{{sk.citations && sk.citations.length > 0}}" class="skill-cite-tags">
                <text
                  wx:for="{{sk.citations}}"
                  wx:for-item="c"
                  wx:key="title"
                  class="skill-cite-tag"
                >
                  📖 {{c.title}}
                </text>
              </view>
            </view>
          </view>

          <!-- 情绪关怀护栏暖心卡片 -->
          <view
            wx:if="{{item.role === 'assistant' && item.emotionCare}}"
            class="care-card {{item.emotionCare.level === 'crisis' ? 'care-crisis' : 'care-distress'}}"
          >
            <view class="care-title">
              {{item.emotionCare.level === 'crisis' ? '🤍' : '🌙'}} {{item.emotionCare.title}}
            </view>
            <view class="care-msg">{{item.emotionCare.message}}</view>
            <view wx:if="{{item.emotionCare.hotlines && item.emotionCare.hotlines.length}}" class="care-hotlines">
              <view
                wx:for="{{item.emotionCare.hotlines}}"
                wx:for-item="h"
                wx:key="name"
                class="hotline-chip"
                data-phone="{{h.phone}}"
                bindtap="onTapHotline"
              >
                <text>{{h.name}}</text>
                <text class="hotline-num">{{h.phone}}</text>
              </view>
            </view>
          </view>

          <!-- 底部复制与收藏操作 -->
          <view wx:if="{{item.role === 'assistant' && item.content}}" class="bubble-foot">
            <text
              class="fav-btn"
              data-content="{{item.content}}"
              data-label="{{item.modelLabel}}"
              bindtap="onFavoriteMessage"
            >
              ⭐ 收藏
            </text>
            <text class="copy-btn" data-content="{{item.content}}" bindtap="onCopyMessage">
              复制
            </text>
          </view>
        </view>
      </view>

      <!-- 空态快捷引导（仅开场时展示，开聊后自动收起） -->
      <view wx:if="{{messages.length <= 1 && !sending}}" class="welcome-dock">
        <view class="dock-tools">
          <view class="dock-tool-pill dock-rose" bindtap="goReplyHelper">💬 帮我回消息 · 识图</view>
          <view class="dock-tool-pill dock-ice" bindtap="goSoftenDraft">🧊 先别发 · 降温</view>
        </view>
        <view
          wx:if="{{activePersona && activePersona.starter_prompts && activePersona.starter_prompts.length > 0}}"
          class="dock-starters"
        >
          <view class="dock-label">试试这样问：</view>
          <view
            wx:for="{{activePersona.starter_prompts}}"
            wx:key="*this"
            class="dock-starter-item"
            data-prompt="{{item}}"
            bindtap="onTapStarter"
          >
            <text class="dock-starter-txt">{{item}}</text>
            <text class="dock-starter-go">↗</text>
          </view>
        </view>
      </view>

      <view id="chat-bottom-anchor" style="height: 20rpx;"></view>
    </view>
  </scroll-view>

  <!-- 底部输入栏（TabBar 页无需 safe-bottom，消除底部多余留白） -->
  <view class="chat-composer">
    <input
      class="composer-input"
      placeholder="{{activePersona ? ('向「' + activePersona.name + '」倾诉...') : '说说你的心事或粘贴 TA 的话...'}}"
      value="{{inputValue}}"
      confirm-type="send"
      bindinput="onInputChange"
      bindconfirm="handleSend"
    />
    <button wx:if="{{sending}}" class="composer-stop" bindtap="handleStop">停止</button>
    <button
      wx:else
      class="composer-send"
      disabled="{{!inputValue}}"
      bindtap="handleSend"
    >
      发送
    </button>
  </view>

  <!-- 切换导师与对话模式抽屉 -->
  <view wx:if="{{modeSheetVisible}}" class="sheet-mask" bindtap="onCloseModeSheet">
    <view class="sheet-panel" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">切换导师与模式</text>
        <text class="sheet-close" bindtap="onCloseModeSheet">完成</text>
      </view>
      <scroll-view class="sheet-scroll" scroll-y="true">
        <view class="mode-section-label">选择恋爱导师</view>
        <view class="mode-chip-wrap">
          <view
            class="p-chip {{!selectedPersonaId ? 'p-chip-active' : ''}}"
            data-id=""
            bindtap="onSelectPersona"
          >
            ✨ 默认助手
          </view>
          <view
            wx:for="{{personas}}"
            wx:key="id"
            class="p-chip {{selectedPersonaId === item.id ? 'p-chip-active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onSelectPersona"
          >
            {{item.avatar_emoji || '💘'}} {{item.name}}
          </view>
        </view>
        <view wx:if="{{activePersona && activePersona.description}}" class="mode-persona-hint">
          {{activePersona.description}}
        </view>

        <view wx:if="{{skills.length > 0}}" class="mode-section-block">
          <view class="mode-section-label">专属知识库</view>
          <view class="mode-chip-wrap">
            <view
              class="sk-chip {{selectedSkillIds.length === 0 ? 'sk-chip-active' : ''}}"
              data-id=""
              bindtap="onSelectSkill"
            >
              🧩 自动匹配
            </view>
            <view
              wx:for="{{skills}}"
              wx:key="id"
              class="sk-chip {{item._selected ? 'sk-chip-active' : ''}}"
              data-id="{{item.id}}"
              bindtap="onSelectSkill"
            >
              📚 {{item.name}}
            </view>
          </view>
        </view>

        <view class="mode-section-block">
          <view class="mode-section-label">对话设置</view>
          <view class="mode-setting-row">
            <view class="mode-setting-text">
              <view class="mode-setting-title">🕵️ 无痕倾诉模式</view>
              <view class="mode-setting-sub">开启后本轮对话绝不存入云端历史</view>
            </view>
            <switch
              checked="{{incognitoMode}}"
              color="#c83553"
              bindchange="onToggleIncognito"
            />
          </view>
          <view class="mode-setting-row" bindtap="onGoLoveProfileFromSheet">
            <view class="mode-setting-text">
              <view class="mode-setting-title">💞 我的情感档案</view>
              <view class="mode-setting-sub">
                {{loveProfileActive ? (loveProfileStage || '记忆已生效，聊天无需重复交代') : '未开启，去填写恋爱背景记忆卡'}}
              </view>
            </view>
            <text class="mode-setting-arrow">去设置 ›</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 历史会话底部抽屉 -->
  <view wx:if="{{historyVisible}}" class="sheet-mask" bindtap="onCloseHistory">
    <view class="sheet-panel" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">历史咨询 ({{conversations.length}})</text>
        <text class="sheet-close" bindtap="onCloseHistory">关闭</text>
      </view>
      <scroll-view class="sheet-scroll" scroll-y="true">
        <view wx:if="{{conversations.length === 0}}" class="sheet-empty">
          暂无历史会话，发起第一轮咨询后将自动保存
        </view>
        <view
          wx:for="{{conversations}}"
          wx:key="session_id"
          class="hist-item {{sessionId === item.session_id ? 'hist-active' : ''}} {{item.is_pinned ? 'hist-pinned' : ''}}"
          data-sid="{{item.session_id}}"
          bindtap="onSelectHistoryItem"
        >
          <view class="hist-main">
            <view class="hist-title-row">
              <text wx:if="{{item.is_pinned}}" class="hist-pin">📌</text>
              <text class="hist-title">{{item.title}}</text>
            </view>
            <view class="hist-meta">
              <text class="hist-persona">{{item.persona_name || '自由倾诉'}}</text>
            </view>
          </view>
          <view class="hist-ops" catchtap="noop">
            <text
              class="hist-op-btn"
              data-sid="{{item.session_id}}"
              data-pinned="{{item.is_pinned}}"
              bindtap="onTogglePinConv"
            >
              {{item.is_pinned ? '取消置顶' : '置顶'}}
            </text>
            <text
              class="hist-op-del"
              data-sid="{{item.session_id}}"
              data-title="{{item.title}}"
              bindtap="onDeleteConv"
            >
              删
            </text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>

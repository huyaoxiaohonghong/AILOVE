<view class="chat-page">
  <view class="chat-toolbar">
    <text class="toolbar-info">LangChain 多轮会话</text>
    <text class="toolbar-clear" bindtap="handleClearSession">清空会话</text>
  </view>

  <scroll-view
    class="chat-scroll"
    scroll-y="true"
    scroll-into-view="{{scrollToId}}"
    scroll-with-animation="true"
  >
    <view class="msg-list">
      <view
        wx:for="{{messages}}"
        wx:key="id"
        id="msg-{{item.id}}"
        class="msg-row {{item.role === 'user' ? 'msg-user' : 'msg-ai'}}"
      >
        <view class="msg-bubble">
          <text user-select="true">{{item.content}}</text>
        </view>
      </view>
      <view wx:if="{{sending}}" id="msg-loading" class="msg-row msg-ai">
        <view class="msg-bubble loading-bubble">AI 正在思考中...</view>
      </view>
    </view>
  </scroll-view>

  <view class="chat-composer">
    <input
      class="composer-input"
      placeholder="输入消息，与 AILOVE 智能助手对话"
      value="{{inputValue}}"
      confirm-type="send"
      bindinput="onInputChange"
      bindconfirm="handleSend"
    />
    <button
      class="composer-send"
      disabled="{{sending || !inputValue}}"
      bindtap="handleSend"
    >
      发送
    </button>
  </view>
</view>

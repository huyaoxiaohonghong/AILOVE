.intro-banner {
  background: linear-gradient(135deg, #fff1f4 0%, #fff8f2 100%);
  border: 1rpx solid #f5ccd6;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 22rpx;
}

.intro-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #a92442;
  margin-bottom: 8rpx;
}

.intro-sub {
  font-size: 24rpx;
  color: #6b5867;
  line-height: 1.55;
}

.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #2b2130;
  margin-bottom: 12rpx;
}

.field-head .field-label {
  margin-bottom: 0;
}

.paste-btn {
  font-size: 23rpx;
  color: #c83553;
  background: #fff1f4;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.msg-textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #faf5f7;
  border: 1rpx solid #efe2e7;
  font-size: 27rpx;
  line-height: 1.6;
  color: #1d1720;
}

.tone-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.tone-item {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #faf5f7;
  border: 1rpx solid #efe2e7;
}

.tone-active {
  background: #fff1f4;
  border-color: #d84361;
}

.tone-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1d1720;
  margin-bottom: 4rpx;
}

.tone-active .tone-name {
  color: #c83553;
}

.tone-desc {
  font-size: 21rpx;
  color: #7c7080;
  line-height: 1.45;
}

.text-input {
  width: 100%;
  height: 76rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #faf5f7;
  border: 1rpx solid #efe2e7;
  font-size: 26rpx;
  color: #1d1720;
}

.profile-hint-row {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #faf5f7;
}

.hint-link {
  font-size: 23rpx;
  color: #c83553;
  font-weight: 600;
  flex-shrink: 0;
}

.submit-btn {
  margin-top: 26rpx;
  height: 86rpx;
  line-height: 86rpx;
}

.err-card {
  color: #be123c;
  background: #fff1f2;
  border-color: #fecdd3;
  font-size: 25rpx;
}

.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 18rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #f1e6ea;
}

.result-badge {
  font-size: 23rpx;
  font-weight: 600;
  color: #c83553;
}

.copy-all-btn {
  font-size: 23rpx;
  color: #6b5f70;
}

.quick-replies {
  margin-bottom: 22rpx;
}

.quick-replies-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #1d1720;
  margin-bottom: 12rpx;
}

.reply-quote-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background: #fff5f7;
  border: 1rpx solid #f5ccd6;
}

.reply-quote-txt {
  flex: 1;
  font-size: 26rpx;
  color: #1d1720;
  line-height: 1.55;
}

.reply-quote-copy {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #c83553;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.result-body {
  font-size: 26rpx;
  line-height: 1.7;
  color: #2b2130;
  white-space: pre-wrap;
}

.care-box {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #fff6f7;
  border: 1rpx solid #f3c4cf;
}

.care-box-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #9f1f3a;
  margin-bottom: 6rpx;
}

.care-box-msg {
  font-size: 23rpx;
  color: #5b4d5d;
  line-height: 1.55;
}

.continue-btn {
  margin-top: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.vision-badge {
  font-size: 21rpx;
  color: #8c6e7c;
}

.shot-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.shot-box {
  position: relative;
  width: 146rpx;
  height: 146rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #efe2e7;
}

.shot-img {
  width: 100%;
  height: 100%;
}

.shot-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(29, 23, 32, 0.65);
  color: #ffffff;
  font-size: 24rpx;
}

.shot-add {
  width: 146rpx;
  height: 146rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #ebb8c5;
  background: #fff5f7;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #c83553;
}

.shot-add-plus {
  font-size: 40rpx;
  line-height: 1;
}

.shot-add-txt {
  font-size: 20rpx;
  font-weight: 600;
}

.quote-ops {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.quote-fav {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #f1ccd6;
  font-size: 22rpx;
}

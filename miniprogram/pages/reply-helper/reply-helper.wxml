<view class="container safe-bottom">
  <view class="intro-banner">
    <view class="intro-title">💬 帮我回消息 · 微信高情商参谋</view>
    <view class="intro-sub">
      粘贴对方发来的原话，AI 帮你剖析字面外的潜台词，并生成 3 条可直接发送的自然回复
    </view>
  </view>

  <view class="card">
    <view class="field-head">
      <text class="field-label">对方发来的原话 / 聊天片段 *</text>
      <text class="paste-btn" bindtap="onPasteClipboard">📋 一键粘贴</text>
    </view>
    <textarea
      class="msg-textarea"
      placeholder="例如：最近项目真的太忙了，改天有空再约你吧"
      value="{{partnerMessage}}"
      maxlength="2000"
      auto-height="true"
      bindinput="onPartnerInput"
    />

    <view class="field-label" style="margin-top: 26rpx;">当前互动场景</view>
    <view class="chip-list">
      <view
        wx:for="{{scenes}}"
        wx:key="code"
        class="chip {{scene === item.code ? 'chip-active' : ''}}"
        data-code="{{item.code}}"
        bindtap="onSelectScene"
      >
        {{item.label}}
      </view>
    </view>

    <view class="field-label" style="margin-top: 26rpx;">期望回复语气</view>
    <view class="tone-grid">
      <view
        wx:for="{{tones}}"
        wx:key="code"
        class="tone-item {{tone === item.code ? 'tone-active' : ''}}"
        data-code="{{item.code}}"
        bindtap="onSelectTone"
      >
        <view class="tone-name">{{item.label}}</view>
        <view class="tone-desc">{{item.desc}}</view>
      </view>
    </view>

    <view class="field-label" style="margin-top: 26rpx;">我真实想表达的意思（可选）</view>
    <input
      class="text-input"
      placeholder="例如：想体面收尾不显得粘人，同时留个小钩子"
      value="{{myIntent}}"
      maxlength="400"
      bindinput="onIntentInput"
    />

    <view class="field-label" style="margin-top: 22rpx;">前文背景补充（可选）</view>
    <input
      class="text-input"
      placeholder="例如：之前聊得很热络，这两天回复间隔突然拉长"
      value="{{context}}"
      maxlength="800"
      bindinput="onContextInput"
    />

    <view class="profile-hint-row" bindtap="goLoveProfile">
      <text class="muted-text">
        {{loveProfileActive ? '💞 已开启情感档案记忆，将自动结合你的背景生成建议' : '💡 搭配「我的情感档案」记忆卡，回复会更贴合你们关系'}}
      </text>
      <text class="hint-link">去设置 ›</text>
    </view>

    <button
      class="primary-btn submit-btn"
      loading="{{generating}}"
      disabled="{{generating}}"
      bindtap="handleGenerate"
    >
      {{generating ? '正在拆解潜台词...' : '立即拆解并生成 3 条回复'}}
    </button>
  </view>

  <!-- 错误提示 -->
  <view wx:if="{{errorText}}" class="card err-card">
    ⚠️ {{errorText}}
  </view>

  <!-- 结果区：一键可复制回复卡 + 完整剖析 -->
  <view wx:if="{{resultText || generating}}" class="card result-card">
    <view class="result-head">
      <text class="result-badge">{{resultLabel}}</text>
      <text wx:if="{{resultText}}" class="copy-all-btn" data-text="{{resultText}}" bindtap="onCopyText">
        复制全文
      </text>
    </view>

    <!-- 快捷可复制备选回复卡片 -->
    <view wx:if="{{suggestedReplies.length > 0}}" class="quick-replies">
      <view class="quick-replies-title">✨ 可直接复制发送（轻触复制）</view>
      <view
        wx:for="{{suggestedReplies}}"
        wx:key="*this"
        class="reply-quote-card"
        data-text="{{item}}"
        bindtap="onCopyText"
      >
        <view class="reply-quote-txt">{{item}}</view>
        <view class="reply-quote-copy">复制</view>
      </view>
    </view>

    <!-- 完整拆解内容 -->
    <view class="result-body">
      <text user-select="true">{{resultText || '正在深度剖析对方潜台词与情绪温度...'}}</text>
    </view>

    <!-- 情绪关怀护栏卡片 -->
    <view wx:if="{{emotionCare}}" class="care-box">
      <view class="care-box-title">🌙 {{emotionCare.title}}</view>
      <view class="care-box-msg">{{emotionCare.message}}</view>
    </view>

    <button
      wx:if="{{resultSessionId && !generating}}"
      class="ghost-btn continue-btn"
      bindtap="onContinueInChat"
    >
      转入对话继续追问 ›
    </button>
  </view>
</view>

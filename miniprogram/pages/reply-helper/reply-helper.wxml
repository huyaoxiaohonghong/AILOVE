<view class="container safe-bottom">
  <view class="card">
    <view class="field-head">
      <text class="field-label">微信截图识图（可选，最多 3 张）</text>
      <text class="vision-badge">{{hasVisionModel ? '👁️ 识图已就绪' : '📸 支持识图'}}</text>
    </view>
    <view class="shot-row">
      <view wx:for="{{images}}" wx:key="*this" class="shot-box">
        <image class="shot-img" src="{{item}}" mode="aspectFill" />
        <view class="shot-del" data-idx="{{index}}" bindtap="onRemoveImage">×</view>
      </view>
      <view wx:if="{{images.length < 3}}" class="shot-add" bindtap="onChooseImages">
        <text class="shot-add-plus">＋</text>
        <text class="shot-add-txt">传聊天截图</text>
      </view>
    </view>

    <view class="field-head" style="margin-top: 22rpx;">
      <text class="field-label">对方发来的原话（传图时可选）</text>
      <text class="paste-btn" bindtap="onPasteClipboard">📋 一键粘贴</text>
    </view>
    <textarea
      class="msg-textarea"
      placeholder="粘贴对方的话，例如：最近太忙了，改天有空再约吧"
      value="{{partnerMessage}}"
      maxlength="2000"
      auto-height="true"
      bindinput="onPartnerInput"
    />

    <view class="field-label" style="margin-top: 22rpx;">互动场景</view>
    <view class="chip-list">
      <view
        wx:for="{{scenes}}"
        wx:key="code"
        class="chip {{scene === item.code ? 'chip-active' : ''}}"
        data-code="{{item.code}}"
        bindtap="onSelectScene"
      >
        {{item.label}}
      </view>
    </view>

    <view class="field-label" style="margin-top: 22rpx;">期望语气</view>
    <view class="chip-list">
      <view
        wx:for="{{tones}}"
        wx:key="code"
        class="chip {{tone === item.code ? 'chip-active' : ''}}"
        data-code="{{item.code}}"
        bindtap="onSelectTone"
      >
        {{item.label}}
      </view>
    </view>

    <!-- 可选补充折叠区 -->
    <view class="more-toggle" bindtap="onToggleMoreOptions">
      <text class="more-toggle-txt">
        {{showMoreOptions ? '收起补充说明' : '补充我的意图 / 前文背景（可选）'}}
      </text>
      <text class="more-toggle-arrow">{{showMoreOptions ? '▲' : '▼'}}</text>
    </view>

    <view wx:if="{{showMoreOptions}}" class="more-fields">
      <view class="field-label">我真实想表达的意思</view>
      <input
        class="text-input"
        placeholder="例如：想体面收尾不显得粘人，同时留个小钩子"
        value="{{myIntent}}"
        maxlength="400"
        bindinput="onIntentInput"
      />

      <view class="field-label" style="margin-top: 18rpx;">前文背景补充</view>
      <input
        class="text-input"
        placeholder="例如：之前聊得很热络，这两天回复间隔突然拉长"
        value="{{context}}"
        maxlength="800"
        bindinput="onContextInput"
      />
    </view>

    <view class="profile-hint-row" bindtap="goLoveProfile">
      <text class="muted-text">
        {{loveProfileActive ? '💞 已结合你的情感档案记忆' : '💡 填写情感档案，回复更贴合你们关系'}}
      </text>
      <text class="hint-link">{{loveProfileActive ? '查看 ›' : '去填写 ›'}}</text>
    </view>

    <button
      class="primary-btn submit-btn"
      loading="{{generating}}"
      disabled="{{generating}}"
      bindtap="handleGenerate"
    >
      {{generating ? '正在拆解潜台词...' : '拆解潜台词并生成 3 条回复'}}
    </button>
  </view>

  <!-- 错误提示 -->
  <view wx:if="{{errorText}}" class="card err-card">
    ⚠️ {{errorText}}
  </view>

  <!-- 结果区：一键可复制回复卡 + 完整剖析 -->
  <view wx:if="{{resultText || generating}}" class="card result-card">
    <view class="result-head">
      <text class="result-badge">{{resultLabel}}</text>
      <text wx:if="{{resultText}}" class="copy-all-btn" data-text="{{resultText}}" bindtap="onCopyText">
        复制全文
      </text>
    </view>

    <!-- 快捷可复制备选回复卡片 -->
    <view wx:if="{{suggestedReplies.length > 0}}" class="quick-replies">
      <view class="quick-replies-title">✨ 可直接复制或收藏</view>
      <view wx:for="{{suggestedReplies}}" wx:key="*this" class="reply-quote-card">
        <view class="reply-quote-txt" data-text="{{item}}" bindtap="onCopyText">{{item}}</view>
        <view class="quote-ops">
          <text class="quote-fav" data-text="{{item}}" bindtap="onFavoriteText">⭐</text>
          <text class="reply-quote-copy" data-text="{{item}}" bindtap="onCopyText">复制</text>
        </view>
      </view>
    </view>

    <!-- 完整拆解内容 -->
    <view class="result-body">
      <text user-select="true">{{resultText || '正在深度剖析对方潜台词与情绪温度...'}}</text>
    </view>

    <!-- 情绪关怀护栏卡片 -->
    <view wx:if="{{emotionCare}}" class="care-box">
      <view class="care-box-title">🌙 {{emotionCare.title}}</view>
      <view class="care-box-msg">{{emotionCare.message}}</view>
    </view>

    <button
      wx:if="{{resultSessionId && !generating}}"
      class="ghost-btn continue-btn"
      bindtap="onContinueInChat"
    >
      转入对话继续追问 ›
    </button>
  </view>
</view>

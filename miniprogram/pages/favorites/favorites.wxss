.add-box {
  margin-bottom: 20rpx;
}

.fav-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #faf5f7;
  border: 1rpx solid #efe2e7;
  font-size: 26rpx;
  color: #1d1720;
  margin-bottom: 16rpx;
}

.fav-add-foot {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.note-input {
  flex: 1;
  height: 70rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #faf5f7;
  border: 1rpx solid #efe2e7;
  font-size: 24rpx;
}

.add-btn {
  width: 140rpx;
  height: 70rpx;
  line-height: 70rpx;
  font-size: 26rpx;
  margin: 0;
  padding: 0;
}

.cat-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.cat-row {
  display: inline-flex;
  gap: 12rpx;
}

.cat-pill {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #66596a;
  font-size: 24rpx;
  border: 1rpx solid #eee2e7;
}

.cat-pill-active {
  background: #c83553;
  color: #ffffff;
  border-color: #c83553;
  font-weight: 600;
}

.empty-box {
  text-align: center;
  padding: 80rpx 30rpx;
  font-size: 25rpx;
  color: #8c8091;
  line-height: 1.6;
}

.fav-card {
  margin-bottom: 18rpx;
}

.fav-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.fav-tag {
  font-size: 21rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #fff1f4;
  color: #c83553;
  font-weight: 600;
}

.fav-ops {
  display: flex;
  gap: 20rpx;
}

.fav-copy {
  font-size: 23rpx;
  color: #c83553;
  font-weight: 600;
}

.fav-del {
  font-size: 23rpx;
  color: #9b8e9f;
}

.fav-content {
  font-size: 27rpx;
  line-height: 1.65;
  color: #1d1720;
  white-space: pre-wrap;
}

.fav-note {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7c7080;
}

@import "../reply-helper/reply-helper.wxss";

.intensity-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.intensity-seg {
  padding: 18rpx 10rpx;
  border-radius: 16rpx;
  background: #faf5f7;
  border: 1rpx solid #efe2e7;
  text-align: center;
}

.intensity-active {
  background: #fff1f4;
  border-color: #d84361;
}

.intensity-name {
  font-size: 25rpx;
  font-weight: 600;
  color: #4b4050;
}

.intensity-active .intensity-name {
  color: #c83553;
  font-weight: 700;
}

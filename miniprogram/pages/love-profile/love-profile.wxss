.switch-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fff1f4 0%, #fff8f2 100%);
  border: 1rpx solid #f5ccd6;
  margin-bottom: 20rpx;
}

.switch-left {
  flex: 1;
  min-width: 0;
}

.switch-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #a92442;
  margin-bottom: 4rpx;
}

.switch-desc {
  font-size: 22rpx;
  color: #6b5867;
  line-height: 1.5;
}

.field-label {
  font-size: 25rpx;
  font-weight: 700;
  color: #2b2130;
  margin-bottom: 12rpx;
}

.text-input {
  width: 100%;
  height: 74rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: #faf5f7;
  border: 1rpx solid #efe2e7;
  font-size: 25rpx;
  color: #1d1720;
}

.chosen-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.chosen-label {
  font-size: 22rpx;
  color: #8c8091;
}

.chosen-pill {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #ffe8ee;
  color: #c83553;
  font-size: 22rpx;
  font-weight: 600;
}

.custom-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.custom-input {
  flex: 1;
  min-width: 0;
  height: 70rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #faf5f7;
  border: 1rpx solid #efe2e7;
  font-size: 24rpx;
}

.add-tag-btn {
  width: 118rpx !important;
  flex-shrink: 0;
  height: 70rpx;
  padding: 0;
  border-radius: 14rpx;
  background: #fff1f4;
  color: #c83553;
  border: 1rpx solid #f3bcc9;
  font-size: 24rpx;
  font-weight: 600;
}

.notes-textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: #faf5f7;
  border: 1rpx solid #efe2e7;
  font-size: 25rpx;
  line-height: 1.6;
}

.footer-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.clear-btn {
  width: 204rpx !important;
  flex-shrink: 0;
  height: 82rpx;
}

.save-btn {
  flex: 1;
  width: 0;
  height: 82rpx;
}

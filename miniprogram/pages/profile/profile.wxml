<view class="container">
  <!-- 顶部个人信息卡片 -->
  <view class="hero-profile">
    <view class="profile-top">
      <view class="avatar-circle">
        <text>{{avatarInitial}}</text>
      </view>
      <view class="profile-meta">
        <view class="name-row">
          <text class="user-name">{{userInfo ? userInfo.nickname : '未登录访客'}}</text>
          <text wx:if="{{userInfo}}" class="edit-name-btn" bindtap="handleEditNickname">改昵称</text>
        </view>
        <view class="user-sub">
          {{userInfo ? (quotaSummary || '欢迎回到你的专属情感空间') : '一键微信登录，同步你的情感档案与咨询记录'}}
        </view>
      </view>
    </view>

    <button
      wx:if="{{!userInfo}}"
      class="login-pill-btn"
      loading="{{loggingIn}}"
      bindtap="handleWxLogin"
    >
      微信一键登录
    </button>
  </view>

  <!-- 邀请码未激活提示 -->
  <view wx:if="{{inviteLocked}}" class="card invite-card">
    <view class="invite-title">🔐 填写内测邀请码解锁全部 AI 功能</view>
    <view class="invite-row">
      <input
        class="invite-input"
        placeholder="输入邀请码（如 LOVE-XXXXXX）"
        value="{{inviteInput}}"
        maxlength="32"
        bindinput="onInviteInput"
      />
      <button
        class="primary-btn invite-btn"
        loading="{{verifyingInvite}}"
        bindtap="handleVerifyInvite"
      >
        激活
      </button>
    </view>
  </view>

  <!-- 个人情感资产（仅保留个人数据与隐私，不与首页工具重复） -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="goLoveProfile">
      <view class="menu-left">
        <text class="menu-emoji">💞</text>
        <view class="menu-info">
          <view class="menu-title">我的情感档案</view>
          <view class="muted-text">
            {{loveProfile && loveProfile.is_configured ? ((loveProfile.relationship_stage_label || '已填写') + (loveProfile.auto_inject ? ' · 自动记忆中' : ' · 已暂停')) : '填写恋爱背景，聊天无需重复交代'}}
          </view>
        </view>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goFavorites">
      <view class="menu-left">
        <text class="menu-emoji">⭐</text>
        <view class="menu-info">
          <view class="menu-title">高情商话术库</view>
          <view class="muted-text">珍藏的破冰句、救场金句与回复模版</view>
        </view>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goHistoryChat">
      <view class="menu-left">
        <text class="menu-emoji">📜</text>
        <view class="menu-info">
          <view class="menu-title">历史咨询记录</view>
          <view class="muted-text">已保存 {{conversationCount}} 条私密对话</view>
        </view>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view wx:if="{{userInfo}}" class="menu-item" bindtap="onOpenPrivacySheet">
      <view class="menu-left">
        <text class="menu-emoji">🔐</text>
        <view class="menu-info">
          <view class="menu-title">数据与隐私</view>
          <view class="muted-text">导出私密情感手账，或彻底清空云端数据</view>
        </view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <button wx:if="{{userInfo}}" class="logout-btn" bindtap="handleLogout">退出当前登录</button>

  <!-- 极简页脚（连点 5 次可呼出开发者连通诊断弹窗） -->
  <view class="brand-footer" bindtap="onTapVersionFooter">
    <text>AILOVE · 专属情感伴侣</text>
  </view>

  <!-- 隐藏的开发者诊断弹窗 -->
  <view wx:if="{{devPanelVisible}}" class="dev-mask" bindtap="onCloseDevPanel">
    <view class="dev-modal" catchtap="noop">
      <view class="dev-head">
        <text class="dev-title">开发者服务诊断</text>
        <status-badge type="{{healthType}}" text="{{healthText}}" />
      </view>
      <view class="env-line">
        <text class="muted-text">当前环境</text>
        <text class="env-val">{{envLabel}} · {{healthModel}}</text>
      </view>
      <view class="env-line">
        <text class="muted-text">接口地址</text>
        <text class="env-url">{{apiBaseUrl}}</text>
      </view>
      <view class="env-btns">
        <button class="ghost-btn env-btn" bindtap="checkHealth">检测连通</button>
        <button class="ghost-btn env-btn" bindtap="handleSwitchEnv">
          切至{{envKey === 'cloud' ? '本机开发服' : '云端测试服'}}
        </button>
      </view>
      <button class="dev-close-btn" bindtap="onCloseDevPanel">关闭</button>
    </view>
  </view>
</view>

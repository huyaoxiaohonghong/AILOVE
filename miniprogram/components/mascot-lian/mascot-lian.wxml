<view class="mascot-container">
  <!-- 贴边探头模式（萌趣半颗小脑袋偷看） -->
  <view
    wx:if="{{minimized}}"
    class="peek-anchor dock-{{dockSide}}"
    style="top: {{topPx}}px;"
    bindtap="onRestore"
  >
    <view
      wx:if="{{bubbleText}}"
      class="speech-bubble peek-bubble side-{{dockSide}}"
      catchtap="onOpenFromBubble"
    >
      <text class="bubble-msg">{{bubbleText}}</text>
      <view class="bubble-close" catchtap="onCloseBubble">×</view>
    </view>
    <view class="peek-circle">
      <image class="peek-img" src="{{spritePath}}" mode="aspectFit" />
    </view>
  </view>

  <!-- 可拖拽、多手势悬浮动画精灵 -->
  <view
    wx:else
    class="floating-mascot {{dragging ? 'is-dragging' : ''}}"
    style="left: {{leftPx}}px; top: {{topPx}}px;"
    bindtouchstart="onTouchStart"
    catchtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
    bindtouchcancel="onTouchEnd"
  >
    <!-- 主动问候 / 互动反馈气泡 -->
    <view
      wx:if="{{bubbleText && !drawerOpen}}"
      class="speech-bubble side-{{dockSide}}"
      catchtap="onOpenFromBubble"
    >
      <text class="bubble-msg">{{bubbleText}}</text>
      <view class="bubble-close" catchtap="onCloseBubble">×</view>
    </view>

    <!-- 粒子反馈（爱心 / 星星 / 感叹号） -->
    <text
      wx:for="{{burstHearts}}"
      wx:key="id"
      class="burst-heart"
      style="--tx: {{item.tx}}px; --ty: {{item.ty}}px;"
    >{{item.sym || '♥'}}</text>

    <!-- 角色立绘 + 弹簧/拎起摆动/情绪动效 -->
    <view
      class="sprite-stage mood-{{effectiveMood}} {{bouncing ? 'is-bouncing' : ''}}"
      style="transform: rotate({{dragTiltDeg}}deg);"
    >
      <image class="sprite-img" src="{{spritePath}}" mode="aspectFit" />
      <view class="name-pill">
        <view class="status-dot mood-{{effectiveMood}}" />
        <text class="name-text">恋恋</text>
        <text class="lv-tag">Lv.{{bondLevel}}</text>
      </view>
    </view>
  </view>

  <!-- 半屏智能问答舱 2.0 -->
  <view wx:if="{{drawerOpen && !minimized}}" class="sheet-mask-wrap" catchtap="onCloseDrawer">
    <view class="lian-sheet" catchtap="noop">
      <!-- 顶部身份与羁绊条 -->
      <view class="sheet-header">
        <view class="sheet-id">
          <image class="header-avatar" src="{{spritePath}}" mode="aspectFit" />
          <view class="header-info">
            <view class="header-title-row">
              <text class="header-name">恋恋</text>
              <text class="bond-badge">Lv.{{bondLevel}} {{bondTitle}}</text>
              <text class="header-badge">{{moodStatusText}}</text>
            </view>
            <view class="affinity-track">
              <view class="affinity-fill" style="width: {{affinityPercent}}%;" />
            </view>
          </view>
        </view>
        <view class="header-ops">
          <view class="op-btn {{showMemories ? 'op-btn-on' : ''}}" bindtap="onToggleMemories">🧠 {{memories.length}}</view>
          <view class="op-btn" bindtap="onResetTopic">新话题</view>
          <view class="op-btn" bindtap="onMinimize">探头</view>
          <view class="op-btn op-close" bindtap="onCloseDrawer">×</view>
        </view>
      </view>

      <!-- 恋恋记忆查看抽屉（透明可删） -->
      <view wx:if="{{showMemories}}" class="mem-drawer">
        <view class="mem-head">
          <text>🧠 恋恋记住的近期心事（艾宾浩斯动态强化）</text>
          <text class="mem-close" bindtap="onToggleMemories">收起</text>
        </view>
        <view wx:if="{{memories.length === 0}}" class="mem-empty">
          还没有专属记忆哦，多和我聊聊心事，我会悄悄记住你们的偏好~
        </view>
        <view wx:else class="mem-list">
          <view wx:for="{{memories}}" wx:key="id" class="mem-item">
            <text class="mem-cat">{{item.category}}</text>
            <text class="mem-txt">{{item.summary}}</text>
            <text class="mem-del" data-id="{{item.id}}" bindtap="onForgetMemory">×</text>
          </view>
        </view>
      </view>

      <!-- 4-4-4 互动呼吸引导仪式 -->
      <view wx:if="{{breathingActive}}" class="breath-panel">
        <view class="breath-orb" style="transform: scale({{breathingScale}});">
          <text>{{breathingPhase}}</text>
        </view>
        <view class="breath-foot">
          <text>和恋恋一起慢呼吸 · 剩余 {{breathingRemainSec}}s</text>
          <text class="breath-stop" bindtap="stopBreathing">结束</text>
        </view>
      </view>

      <!-- 常用功能直达条 -->
      <scroll-view scroll-x class="quick-nav-bar" enable-flex>
        <view class="quick-nav-list">
          <view
            wx:for="{{quickRoutes}}"
            wx:key="path"
            class="quick-nav-pill"
            data-path="{{item.path}}"
            bindtap="onQuickNav"
          >
            {{item.label}} →
          </view>
        </view>
      </scroll-view>

      <!-- 对话内容滚动区 -->
      <scroll-view
        scroll-y
        class="sheet-body"
        scroll-into-view="{{scrollIntoId}}"
        scroll-with-animation
      >
        <!-- 每日心情轻打卡条 -->
        <view wx:if="{{needMoodCheckin}}" class="checkin-card">
          <view class="checkin-title">今天心情怎么样？轻点一下告诉恋恋</view>
          <view class="checkin-row">
            <view
              wx:for="{{moodChoices}}"
              wx:key="score"
              class="checkin-item"
              data-score="{{item.score}}"
              bindtap="onTapMoodCheckin"
            >
              <text class="ci-emoji">{{item.emoji}}</text>
              <text class="ci-label">{{item.label}}</text>
            </view>
          </view>
        </view>

        <!-- 低谷情绪关怀卡 -->
        <view wx:if="{{emotionCare}}" class="care-card">
          <text class="care-title">💗 {{emotionCare.title}}</text>
          <text class="care-msg">{{emotionCare.message}}</text>
        </view>

        <!-- 空状态与快捷提问 -->
        <view wx:if="{{messages.length === 0}}" class="empty-panel">
          <view class="empty-welcome">
            <text class="empty-title">✨ 恋恋 2.0 情感大脑已上线</text>
            <text class="empty-desc">摸摸我的头、戳脸蛋、长按抱抱都会有不同小反应~ 聊到心事我还能帮你一键带入工具或顺手记进情感档案哦！</text>
          </view>
          <view class="prompt-grid">
            <view
              wx:for="{{quickPrompts}}"
              wx:key="*this"
              class="prompt-chip"
              data-prompt="{{item}}"
              bindtap="onQuickPrompt"
            >
              {{item}}
            </view>
          </view>
        </view>

        <!-- 消息气泡流 -->
        <view wx:else class="msg-list">
          <view wx:for="{{messages}}" wx:key="id" class="msg-item msg-{{item.role}}">
            <view class="msg-bubble">
              <text user-select>{{item.content || '恋恋正在竖起耳朵认真想...'}}</text>
            </view>

            <!-- 结构化行动卡片 -->
            <view wx:if="{{item.toolCard}}" class="tool-exec-card">
              <view class="tool-exec-tag">✨ 恋恋行动建议</view>
              <view wx:if="{{item.toolCard.summary}}" class="tool-exec-sub">{{item.toolCard.summary}}</view>
              <view
                class="tool-exec-btn {{item.toolApplied ? 'is-done' : ''}}"
                data-idx="{{index}}"
                bindtap="onTapToolCard"
              >
                {{item.toolApplied ? '已记入档案 ✓' : (item.toolCard.label + ' →')}}
              </view>
            </view>

            <view wx:if="{{item.role === 'assistant' && item.content && !sending}}" class="msg-tools">
              <view class="tool-btn" data-content="{{item.content}}" bindtap="onCopyReply">复制</view>
              <view
                class="tool-btn {{item.favorited ? 'is-saved' : ''}}"
                data-idx="{{index}}"
                bindtap="onFavoriteReply"
              >
                {{item.favorited ? '已存金句 ✓' : '+ 存金句'}}
              </view>
            </view>
          </view>
        </view>

        <view id="lian-bottom-anchor" class="bottom-anchor" />
      </scroll-view>

      <!-- 底部输入区 -->
      <view class="sheet-footer">
        <view class="composer-row">
          <input
            class="composer-input"
            value="{{inputValue}}"
            placeholder="对恋恋说说心事，或贴一句 TA 的话..."
            confirm-type="send"
            bindinput="onInputChange"
            bindconfirm="onSendInput"
          />
          <view
            class="send-btn {{!inputValue || sending ? 'is-disabled' : ''}}"
            bindtap="onSendInput"
          >
            {{sending ? '...' : '发送'}}
          </view>
        </view>
        <view class="footer-meta">
          <text class="drag-hint">摸头 / 戳脸 / 长按抱抱 · 拖动停靠</text>
          <text class="deep-link" bindtap="onGoFullChat">转 AI 咨询深聊 →</text>
        </view>
      </view>
    </view>
  </view>
</view>

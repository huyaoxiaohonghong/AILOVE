.badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.badge-success {
  background: #ecfdf5;
  color: #059669;
}

.badge-success .dot {
  background: #10b981;
}

.badge-warning {
  background: #fffbeb;
  color: #d97706;
}

.badge-warning .dot {
  background: #f59e0b;
}

.badge-danger {
  background: #fef2f2;
  color: #dc2626;
}

.badge-danger .dot {
  background: #ef4444;
}

.badge-info {
  background: #fff2f5;
  color: #c83553;
}

.badge-info .dot {
  background: #d84361;
}

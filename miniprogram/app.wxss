page {
  background-color: #faf7f8;
  color: #1d1720;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
}

.container {
  padding: 26rpx 28rpx 40rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #f1e6ea;
  box-shadow: 0 8rpx 24rpx rgba(200, 53, 83, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d1720;
  margin-bottom: 14rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d1720;
}

.section-more {
  font-size: 24rpx;
  color: #c83553;
  font-weight: 500;
}

.muted-text {
  font-size: 24rpx;
  color: #7c7080;
  line-height: 1.5;
}

.primary-btn {
  background: linear-gradient(135deg, #d84361 0%, #c83553 100%);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 10rpx 22rpx rgba(200, 53, 83, 0.24);
}

.primary-btn::after {
  border: none;
}

.ghost-btn {
  background: #fff2f5;
  color: #c83553;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 1rpx solid #f5ccd5;
}

.ghost-btn::after {
  border: none;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #f8f2f4;
  color: #5b4f5f;
  font-size: 24rpx;
  border: 1rpx solid #ede1e6;
}

.chip-active {
  background: #fff1f4;
  color: #c83553;
  border-color: #d84361;
  font-weight: 600;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

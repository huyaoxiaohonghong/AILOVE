page {
  background-color: #faf7f8;
  color: #1d1720;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* 根治微信 style: "v2" 默认 button 184px 固定宽与内边距错位 */
button:not([size='mini']) {
  width: auto;
  min-height: 0;
  margin: 0;
  padding: 0 28rpx;
  line-height: 1.2;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-weight: 600;
}

button::after {
  border: none;
}

.container {
  padding: 24rpx 26rpx 36rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid #f1e6ea;
  box-shadow: 0 6rpx 20rpx rgba(200, 53, 83, 0.04);
  box-sizing: border-box;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1d1720;
  margin-bottom: 14rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1d1720;
}

.section-more {
  font-size: 24rpx;
  color: #c83553;
  font-weight: 500;
}

.muted-text {
  font-size: 24rpx;
  color: #7c7080;
  line-height: 1.5;
}

.primary-btn {
  width: 100%;
  height: 84rpx;
  background: linear-gradient(135deg, #d84361 0%, #c83553 100%);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(200, 53, 83, 0.22);
}

.ghost-btn {
  height: 76rpx;
  background: #fff2f5;
  color: #c83553;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: 1rpx solid #f5ccd5;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #f8f2f4;
  color: #5b4f5f;
  font-size: 24rpx;
  border: 1rpx solid #ede1e6;
}

.chip-active {
  background: #fff1f4;
  color: #c83553;
  border-color: #d84361;
  font-weight: 600;
}

.safe-bottom {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

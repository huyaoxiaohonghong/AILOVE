# 应用基础配置
APP_NAME=AILOVE API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 安全与 JWT 配置（生产环境务必替换 SECRET_KEY；默认 1440 分钟 = 24 小时自动过期）
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
MAX_SESSIONS_PER_USER=5
LOGIN_MAX_FAIL_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
TRUST_X_FORWARDED_FOR=false

# 初始化管理员账号（开发环境首次启动/未连库调试使用）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin123456
ALLOW_DEV_FALLBACK_AUTH=true

# MySQL 数据库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ailove
MYSQL_PASSWORD=ailove_123456
MYSQL_ROOT_PASSWORD=ailove_root_123456
MYSQL_DATABASE=ailove
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=ailove_redis_123456
REDIS_DB=0

# LangChain / LLM 默认回退配置（首期默认 DeepSeek，支持 OpenAI / Anthropic 双协议动态配置）
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
LLM_SYSTEM_PROMPT=你是 AILOVE 智能助手，请用清晰、温暖、专业的中文回答用户问题。

# 微信小程序配置
WECHAT_APP_ID=
WECHAT_APP_SECRET=
